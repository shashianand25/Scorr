# ── Database ─────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/dbname?sslmode=require

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
ADMIN_EMAIL=your@email.com

# ── AI (Gemini / Vertex AI) ───────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxx
# Full Vertex AI endpoint URL for the model you want to use
GEMINI_MODEL_URL=https://asia-south1-aiplatform.googleapis.com/v1/projects/YOUR_PROJECT/locations/asia-south1/publishers/google/models/gemini-2.0-flash:generateContent
GEMINI_MAX_OUTPUT_TOKENS=65536
GEMINI_TEMPERATURE=0.2
# How long (ms) the client waits before showing "Taking longer than usual..."
AI_GENERATION_TIMEOUT_MS=60000

# ── File upload limits ────────────────────────────────────────────────────────
# Max size of JSON request bodies (e.g. quiz source text). Append 'mb' in code.
JSON_BODY_LIMIT_MB=10

# ── App versioning ────────────────────────────────────────────────────────────
# Users below minimumVersion are force-updated and cannot use the app.
APP_MINIMUM_VERSION=1.0.0
APP_LATEST_VERSION=1.0.0

# ── Update prompt schedule ────────────────────────────────────────────────────
# Comma-separated days after first dismissal to re-prompt optional updates.
# Default if unset: 0,7,14,30
UPDATE_PROMPT_SCHEDULE_DAYS=0,7,14,30

# ── Emergency feature flags ───────────────────────────────────────────────────
# Set any of these to 'true' to instantly disable that feature for ALL users.
# No app release needed — takes effect on the next API call.
MAINTENANCE_MODE=false   # true  → full-screen maintenance gate
DISABLE_AI=false         # true  → AI quiz generation blocked with alert
DISABLE_BATTLES=false    # true  → Battle Arena blocked with alert
