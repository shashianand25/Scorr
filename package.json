{
  "name": "scorr",
  "version": "1.0.0",
  "description": "Scorr - AI-Powered MCQ Generator, Flashcard Mastery & Spaced Repetition Platform",
  "private": true,
  "author": "Shashi Anand",
  "license": "MIT",
  "homepage": "https://github.com/shashianand25/Scorr#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/shashianand25/Scorr.git"
  },
  "bugs": {
    "url": "https://github.com/shashianand25/Scorr/issues"
  },
  "keywords": [
    "education",
    "ai",
    "spaced-repetition",
    "supermemo-2",
    "flashcards",
    "mcq-generator",
    "react-native",
    "expo",
    "nextjs",
    "gemini"
  ],
  "workspaces": [
    "mobile",
    "web",
    "backend"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "npm --prefix backend start",
    "dev": "npm --prefix backend run dev",
    "build": "npm --prefix web run build",
    "test": "npm --prefix mobile test",
    "test:mobile": "npm --prefix mobile test",
    "test:web": "npm --prefix web test",
    "test:backend": "npm --prefix backend test",
    "test:all": "npm --prefix mobile test && npm --prefix web test && npm --prefix backend test",
    "test:coverage": "npm --prefix mobile run test:coverage",
    "lint": "npm --prefix mobile run lint",
    "typecheck": "npm --prefix mobile run typecheck",
    "audit:deps": "npm audit --audit-level=critical"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.22.1",
    "firebase": "^12.14.0",
    "i18next": "^26.3.0",
    "lucide-react": "^1.16.0",
    "multer": "^2.1.1",
    "pg": "^8.23.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "babel-jest": "^30.4.1",
    "eslint": "^8.57.0",
    "jest": "^30.4.1",
    "prettier": "^3.3.3",
    "typescript": "^5.7.2"
  }
}