# ==============================================================================
# Scorr Monorepo - Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env or configure in your deployment environment.

# ── Backend Environment Variables ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Neon PostgreSQL Database URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/scorr_db?sslmode=require

# Google Gemini AI API Configuration
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent
GEMINI_MAX_OUTPUT_TOKENS=65536
GEMINI_TEMPERATURE=0.2
AI_GENERATION_TIMEOUT_MS=60000

# Email Notifications (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
ADMIN_EMAIL=admin@scorrapp.com

# File Upload & Payload Limits
JSON_BODY_LIMIT_MB=10

# Emergency Feature Flags & App Maintenance
MAINTENANCE_MODE=false
DISABLE_AI=false
DISABLE_BATTLES=false
APP_MINIMUM_VERSION=1.0.0
APP_LATEST_VERSION=1.0.0

# ── Mobile Client Variables (Expo) ────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
EXPO_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_api_key

# Firebase Client SDK Configuration (Mobile)
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSy_your_firebase_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=scorr-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=scorr-app
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=scorr-app.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:android:abcdef123456

# ── Web Client Variables (Next.js) ────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy_your_firebase_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=scorr-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=scorr-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=scorr-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
