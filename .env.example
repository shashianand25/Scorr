# Scorr Monorepo - Environment Configuration Template (.env.example)

# 1. Database Configuration (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.neon.tech/scorr_db?sslmode=require

# 2. AI Question Generation (Google Gemini 2.0)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent
AI_DAILY_LIMIT=10
AI_GENERATION_TIMEOUT_MS=60000

# 3. Transactional Emails (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=support@scorrapp.com
ADMIN_EMAIL=support@scorrapp.com

# 4. Error Tracking & Observability (Sentry)
SENTRY_DSN=https://your_sentry_dsn_here@o000000.ingest.sentry.io/0000000
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn_here@o000000.ingest.sentry.io/0000000
EXPO_PUBLIC_SENTRY_DSN=https://your_sentry_dsn_here@o000000.ingest.sentry.io/0000000

# 5. Mobile App (Expo SDK 56)
EXPO_PUBLIC_FIREBASE_API_KEY=your_mobile_firebase_api_key_here
EXPO_PUBLIC_API_URL=https://api.scorrapp.com
EXPO_PUBLIC_POSTHOG_KEY=phc_your_posthog_key_here
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# 6. Web App (Next.js 15)
NEXT_PUBLIC_FIREBASE_API_KEY=your_web_firebase_api_key_here
NEXT_PUBLIC_API_URL=http://localhost:3000

# 7. Service Port & Body Limits
PORT=3000
JSON_BODY_LIMIT_MB=10
