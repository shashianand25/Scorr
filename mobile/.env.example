# ── Mobile App Environment Configuration (Expo SDK 56) ────────────────────────
# Backend API Base URL
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google Gemini API Key (for client-side fallback/direct inference)
EXPO_PUBLIC_GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Product Analytics & Telemetry (PostHog EU Cloud)
EXPO_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_api_key

# Firebase Authentication & Cloud Storage
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSy_your_firebase_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=scorr-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=scorr-app
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=scorr-app.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:android:abcdef123456
