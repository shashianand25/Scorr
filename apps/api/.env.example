# ── Server Port & Body Limits ──────────────────────────────────────────────────
# Port number for the Express API backend service
PORT=3000
# Maximum allowed JSON body payload size in megabytes
JSON_BODY_LIMIT_MB=10

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL / Neon Connection String
# Local Docker: postgresql://postgres:postgrespassword@localhost:5432/scorr_db?sslmode=disable
# Production Neon: postgresql://user:password@endpoint.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/scorr_db?sslmode=disable

# ── Observability & Error Tracking (Sentry) ──────────────────────────────────
# Sentry DSN for backend Express API error logging and transaction tracing
SENTRY_DSN=https://your_sentry_dsn_here@o000000.ingest.sentry.io/0000000

# ── AI (Gemini 2.0 / Vertex AI) ───────────────────────────────────────────────
# Google Gemini API key for question, flashcard, and explanation generation
GEMINI_API_KEY=your_gemini_api_key_here
# Gemini model endpoint URL (e.g. gemini-2.0-flash generateContent endpoint)
GEMINI_MODEL_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent
# Maximum output tokens generated per chunk call
GEMINI_MAX_OUTPUT_TOKENS=65536
# Sampling temperature for Gemini AI response creativity (0.0 to 1.0)
GEMINI_TEMPERATURE=0.2
# Maximum concurrent chunk generation requests sent to Gemini API
GEMINI_CONCURRENCY_LIMIT=10
# Maximum AI quiz generation requests allowed per user per day
AI_DAILY_LIMIT=10
# Timeout duration in milliseconds for AI generation requests
AI_GENERATION_TIMEOUT_MS=60000
# Custom prompt template for English MCQ and flashcard generation
GEMINI_MCQ_PROMPT_TEMPLATE=your_custom_mcq_prompt_template_here
# Custom prompt template for Russian and Kazakh MCQ and flashcard generation
GEMINI_MCQ_PROMPT_TEMPLATE_RU=your_custom_mcq_prompt_template_ru_here
# Custom prompt template for image-heavy slides and visual PDF parsing
GEMINI_MCQ_PROMPT_TEMPLATE_VISUAL=your_custom_mcq_prompt_template_visual_here

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Resend API key used for sending OTP verification codes and user feedback
RESEND_API_KEY=re_your_resend_api_key_here
# Verified sender email address used for transactional OTP passcodes
RESEND_FROM_EMAIL=support@scorrapp.com
# Destination admin email address where user feedback submissions are forwarded
ADMIN_EMAIL=support@scorrapp.com

# ── Firebase Authentication (Dynamic Server-Client Config) ────────────────────
# Firebase Web API key served dynamically via /api/app-config
FIREBASE_API_KEY=your_firebase_api_key_here
# Firebase authentication domain for client login callbacks
FIREBASE_AUTH_DOMAIN=sample-firebase-ai-app-228f1.firebaseapp.com
# Firebase project identifier
FIREBASE_PROJECT_ID=sample-firebase-ai-app-228f1
# Firebase Cloud Storage bucket URL for document uploads
FIREBASE_STORAGE_BUCKET=sample-firebase-ai-app-228f1.firebasestorage.app
# Firebase Cloud Messaging sender ID for push notifications
FIREBASE_MESSAGING_SENDER_ID=767058687564
# Firebase application ID for client authorization
FIREBASE_APP_ID=1:767058687564:web:8e16972e2cf66f0ee826e9

# ── App Versioning & Schedule ─────────────────────────────────────────────────
# Minimum supported mobile app version before forced update dialog
APP_MINIMUM_VERSION=1.0.0
# Latest published mobile app version available in app stores
APP_LATEST_VERSION=1.0.0
# Title displayed on the forced update modal dialog
APP_UPDATE_TITLE=Update Required
# Message body displayed on the forced update modal dialog
APP_UPDATE_MESSAGE=A critical update is available for Scorr. Please update to the latest version to continue using the app.
# Button label displayed on the forced update modal dialog
APP_UPDATE_BUTTON_TEXT=Update Now
# Comma-separated schedule of days to re-prompt non-blocking updates
UPDATE_PROMPT_SCHEDULE_DAYS=0,7,14,30

# ── Emergency Feature Flags ───────────────────────────────────────────────────
# Emergency flag to toggle system-wide maintenance mode
MAINTENANCE_MODE=false
# Emergency flag to disable AI generation endpoint during outages
DISABLE_AI=false
# Emergency flag to disable multiplayer quiz battles during maintenance
DISABLE_BATTLES=false
